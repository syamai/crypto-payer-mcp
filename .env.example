# Crypto Payer MCP Server Configuration
# Copy this file to one of the following locations:
#   1. ./.env (current working directory)
#   2. ~/.crypto-payer-mcp.env (home directory)
#   3. ~/.config/crypto-payer-mcp/.env (XDG config directory)
# Or set CRYPTO_PAYER_ENV_FILE environment variable to a custom path

# Required: Operator credentials from Crypto Payer PLATFORM
CRYPTO_PAYER_OPERATOR_ID=your-operator-id-here
CRYPTO_PAYER_SECRET_KEY=your-secret-key-here
CRYPTO_PAYER_OPERATOR_NAME=Your Operator Name

# Required: RSA Public Key for webhook signature verification
# Use \n for newlines or put the entire key on one line
CRYPTO_PAYER_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEA...\n-----END PUBLIC KEY-----"

# Optional: API URLs (defaults to testnet)
# Testnet (default):
CRYPTO_PAYER_API_URL=https://dev-api.bclass-solution.com/v1
CRYPTO_PAYER_DOMAIN_URL=https://dev-front.bclass-solution.com

# Mainnet:
# CRYPTO_PAYER_API_URL=https://api.bclass-solution.com/v1
# CRYPTO_PAYER_DOMAIN_URL=https://bclass-solution.com
