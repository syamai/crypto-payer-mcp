{
  "name": "crypto-payer-mcp",
  "version": "1.0.0",
  "description": "MCP Server for Crypto Payer Solution - cryptocurrency payment integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "crypto-payer-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "crypto",
    "cryptocurrency",
    "payment",
    "bitcoin",
    "ethereum",
    "usdt",
    "blockchain",
    "claude",
    "anthropic"
  ],
  "author": "alex <selab.ahn@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syamai/crypto-payer-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/syamai/crypto-payer-mcp/issues"
  },
  "homepage": "https://github.com/syamai/crypto-payer-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
